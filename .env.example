# Copy to .env. Real values never enter the repository.

# Local PostgreSQL from compose.yaml (`docker compose up -d`). Change both if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgres://timon:timon@localhost:5432/timon

# Port of the API; the web dev server proxies /api to it.
PORT=3000

# Set to run the test suite against a PostgreSQL server instead of PGlite.
# Tests drop and recreate the public schema: never point this at a database you care about.
# TEST_DATABASE_URL=postgres://timon:timon@localhost:5432/timon_test
