      "checkConstraints": {
        "resource_driver_fields": {
          "name": "resource_driver_fields",
          "value": "\"resource\".\"kind\" <> 'driver' or (\"resource\".\"last_name\" is not null and \"resource\".\"first_name\" is not null and \"resource\".\"display_name\" is not null and \"resource\".\"plate\" is null and \"resource\".\"vehicle_kind\" is null)"
        },
        "resource_vehicle_fields": {
          "name": "resource_vehicle_fields",
          "value": "\"resource\".\"kind\" = 'driver' or (\"resource\".\"plate\" is not null and \"resource\".\"plate_key\" is not null and \"resource\".\"vehicle_kind\" is not null and \"resource\".\"category\" is not null and \"resource\".\"gvw_kg\" is not null and \"resource\".\"last_name\" is null)"
        },
        "resource_kind_category": {
          "name": "resource_kind_category",
          "value": "\"resource\".\"vehicle_kind\" is null or (\"resource\".\"kind\" = 'power-unit' and (\n        (\"resource\".\"vehicle_kind\" = 'light-van' and \"resource\".\"category\" = 'N1') or\n        (\"resource\".\"vehicle_kind\" in ('rigid-truck', 'tractor') and \"resource\".\"category\" in ('N2', 'N3'))\n      )) or (\"resource\".\"kind\" = 'trailer' and (\n        (\"resource\".\"vehicle_kind\" = 'semi-trailer' and \"resource\".\"category\" in ('O3', 'O4')) or\n        (\"resource\".\"vehicle_kind\" = 'drawbar-trailer' and \"resource\".\"category\" in ('O1', 'O2', 'O3', 'O4'))\n      ))"
        },
        "resource_weights": {
          "name": "resource_weights",
          "value": "(\"resource\".\"gvw_kg\" is null or \"resource\".\"gvw_kg\" > 0) and (\"resource\".\"gcw_kg\" is null or (\"resource\".\"kind\" = 'power-unit' and \"resource\".\"gcw_kg\" > \"resource\".\"gvw_kg\"))"
        },
        "resource_tractor_body_type": {
          "name": "resource_tractor_body_type",
          "value": "\"resource\".\"vehicle_kind\" is distinct from 'tractor' or \"resource\".\"body_type_id\" is null"
        }
      },
      "isRLSEnabled": false
    },
